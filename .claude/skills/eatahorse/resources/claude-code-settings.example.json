            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/eatahorse_hook.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
