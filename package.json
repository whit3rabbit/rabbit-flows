{
  "name": "@whit3rabbit/rabbit-flows",
  "version": "0.1.1",
  "description": "npx installer that bundles Claude Code workflows with the skills and agents they depend on.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whit3rabbit/rabbit-flows.git"
  },
  "bin": {
    "rabbit-flows": "bin/cli.mjs"
  },
  "scripts": {
    "designer": "node frontend/server.js",
    "build:skill": "node scripts/build-skill.mjs",
    "build:docs-contracts": "node scripts/build-docs-contracts.mjs",
    "build:arg-contract": "node scripts/build-arg-contract.mjs",
    "check": "node bin/cli.mjs --check && node scripts/build-skill.mjs --check && node scripts/build-docs-contracts.mjs --check && node scripts/build-arg-contract.mjs --check",
    "test": "node --test"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "fflate": "^0.8.3"
  },
  "files": [
    "bin",
    "installer",
    ".claude/workflows",
    "plugins/workflow-kit",
    "README.md",
    "!**/*-workspace/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
